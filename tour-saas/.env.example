# Sao chép file này thành `.env` rồi điền giá trị.

# Khóa API Claude. Nếu BỎ TRỐNG, app vẫn chạy ở chế độ fallback (sinh lịch trình
# bằng luật, không gọi AI) để bạn xem toàn bộ luồng mà không tốn token.
ANTHROPIC_API_KEY=

# Model dùng để sinh lịch trình. Mặc định Opus 4.8 (chất lượng cao nhất).
# Muốn rẻ hơn cho volume lớn: đổi sang claude-haiku-4-5 hoặc claude-sonnet-4-6.
TOUR_AI_MODEL=claude-opus-4-8

# Thuế VAT mặc định áp lên giá bán (%). Tour VN thường 8% hoặc 10%.
TOUR_VAT_PERCENT=10

# Tỷ giá quy đổi để hiển thị thêm giá USD bên cạnh VND (1 USD = ? VND).
TOUR_USD_VND_RATE=25400

# Cổng chạy server.
PORT=3000
